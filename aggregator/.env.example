# Read from the environment; export these when running outside Docker,
# e.g.  set -a; . aggregator/.env; set +a; python -m aggregator.batch_consumer

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=analytics-aggregator
API_REQUESTS_TOPIC=api-requests
RATE_LIMITED_TOPIC=rate-limited-events
# Only used if the aggregator creates the topics itself
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=1

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=sentryflow
CLICKHOUSE_PASSWORD=sentryflow
CLICKHOUSE_DATABASE=sentryflow
USAGE_RETENTION_DAYS=90

# Batching: write when a batch is this full, or this old, whichever is first
BATCH_SIZE=1000
FLUSH_INTERVAL_SECONDS=2
